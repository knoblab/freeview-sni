{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "FreeView",
  "version": "3.3.1",
  "identifier": "com.qpi.freeview",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "FreeView",
        "width": 354,
        "height": 209,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationHints,MediaRouter,DialMediaRouteProvider --disable-background-networking --disable-sync --disable-default-apps --disable-domain-reliability --no-pings"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.ico"
    ]
  }
}
